    {
      "kind": "CronJob",
      "namespace": "hardening-demo",
      "name": "nightly",
      "action": "patch",
      "rolloutImpact": "future Jobs only; nothing restarts",
      "changes": [
        {
          "container": "",
          "field": "pod.securityContext.seccompProfile.type",
          "from": null,
          "to": "RuntimeDefault"
        },
        {
          "container": "job",
          "field": "container.securityContext.allowPrivilegeEscalation",
          "from": null,
          "to": false
        },
        {
          "container": "job",
          "field": "container.resources.requests.cpu",
          "from": null,
          "to": "100m"
        },
        {
          "container": "job",
          "field": "container.resources.requests.memory",
          "from": null,
          "to": "128Mi"
        },
        {
          "container": "job",
          "field": "container.resources.limits.memory",
          "from": null,
          "to": "512Mi"
        }
      ],
      "findings": [
        {
          "container": "job",
          "rule": "R4",
          "severity": "info",
          "message": "no CPU limit; not set on purpose, CPU limits throttle even on idle nodes"
        },
        {
          "container": "job",
          "rule": "X1",
          "severity": "warning",
          "message": "runAsNonRoot unset; applied only with harden-profile=strict (fails at start if the image runs as root)"
        },
        {
          "container": "job",
          "rule": "X2",
          "severity": "warning",
          "message": "capabilities.drop empty; [ALL] applied only with harden-profile=strict (some images need capabilities such as SETUID)"
        },
        {
          "container": "job",
          "rule": "X3",
          "severity": "warning",
          "message": "readOnlyRootFilesystem unset; applied only with harden-profile=strict (fails if the app writes to its filesystem)"
        }
      ]
    },
